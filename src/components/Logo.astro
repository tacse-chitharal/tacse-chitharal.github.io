---
/**
 * The Academy's seal: a gold ring, an open book, and the rising rays above it —
 * the book the Academy lends, the dawn the students are studying towards.
 */
interface Props {
  class?: string;
}

const { class: className = 'h-12 w-12' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Thiruvalluvar Academy seal"
>
  <circle cx="32" cy="32" r="31" fill="#16366b" />
  <circle cx="32" cy="32" r="29.2" fill="none" stroke="#d4a843" stroke-width="1.6" />
  <circle cx="32" cy="32" r="26.4" fill="none" stroke="#d4a843" stroke-width="0.7" opacity="0.65" />

  <!-- rays -->
  <g stroke="#d4a843" stroke-width="1.5" stroke-linecap="round">
    <path d="M32 13.5v4.2" />
    <path d="M22.2 16.1l2.1 3.6" />
    <path d="M41.8 16.1l-2.1 3.6" />
    <path d="M15.4 22.6l3.6 2.1" />
    <path d="M48.6 22.6l-3.6 2.1" />
  </g>

  <!-- open book -->
  <g fill="none" stroke="#fdfaf3" stroke-width="2.1" stroke-linejoin="round" stroke-linecap="round">
    <path d="M32 31.4c-2.6-2.5-6.3-3.6-11.4-3.6h-5v16.4h5.6c4.6 0 8.4 1 10.8 3.2 2.4-2.2 6.2-3.2 10.8-3.2H48V27.8h-5c-5.1 0-8.8 1.1-11.4 3.6z" />
    <path d="M32 31.4v16" />
  </g>
</svg>
