---
/** The banner at the top of every page other than the home page. */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-navy-800 bg-navy-700">
  <svg
    class="pointer-events-none absolute -right-16 -top-24 h-[22rem] w-[22rem] text-navy-500 opacity-40"
    viewBox="0 0 100 100"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="0.7"
  >
    {
      Array.from({ length: 14 }).map((_, i) => (
        <ellipse cx="50" cy="50" rx="47" ry="13" transform={`rotate(${i * 12.85} 50 50)`} />
      ))
    }
    <circle cx="50" cy="50" r="24"></circle>
    <circle cx="50" cy="50" r="10"></circle>
  </svg>

  <div class="container-page relative py-14 sm:py-16">
    {
      eyebrow && (
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-gold-300">{eyebrow}</p>
      )
    }
    <h1 class="max-w-3xl text-3xl font-bold text-white sm:text-4xl md:text-[2.75rem] md:leading-[1.15]">
      {title}
    </h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-navy-100">{description}</p>
      )
    }
    <div class="mt-6 h-1 w-24 rounded-full bg-gold-400"></div>
  </div>
</section>
