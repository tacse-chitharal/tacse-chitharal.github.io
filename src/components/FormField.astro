---
/**
 * One labelled field inside a Google-Form-backed form.
 *
 * `entry` is the `entry.NNNNN` name from the Google Form. When it has not been
 * filled in yet the control still renders — so the page looks and reads
 * correctly while the Academy is setting things up — but carries no `name`,
 * which keeps an unmapped answer out of the submitted payload entirely.
 */
interface Props {
  fieldKey: string;
  entry: string;
  label: string;
  type?: 'text' | 'tel' | 'email' | 'textarea' | 'select';
  required?: boolean;
  hint?: string;
  placeholder?: string;
  options?: readonly string[];
  rows?: number;
  autocomplete?: string;
  inputmode?: 'text' | 'tel' | 'numeric' | 'email';
  /** Enforces an exact digit count, e.g. 12 for Aadhaar, 10 for a mobile number. */
  digits?: number;
  class?: string;
}

const {
  fieldKey,
  entry,
  label,
  type = 'text',
  required = false,
  hint,
  placeholder,
  options = [],
  rows = 3,
  autocomplete,
  inputmode,
  digits,
  class: className = '',
} = Astro.props;

const id = `field-${fieldKey}`;
const name = entry.trim() || undefined;
const describedBy = hint ? `${id}-hint ${id}-error` : `${id}-error`;

const controlClass =
  'w-full rounded-lg border border-navy-200 bg-white px-3.5 py-2.5 text-[0.95rem] text-ink ' +
  'placeholder:text-ink-soft/55 transition-colors ' +
  'hover:border-navy-300 focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-500/20 ' +
  'group-data-[invalid]:border-rose-400 group-data-[invalid]:ring-2 group-data-[invalid]:ring-rose-400/20';
---

<div class:list={['group', className]} data-field>
  <label for={id} class="mb-1.5 block text-sm font-semibold text-navy-700">
    {label}
    {
      required ? (
        <span class="text-rose-500" aria-hidden="true">
          {' '}
          *
        </span>
      ) : (
        <span class="ml-1 text-xs font-normal text-ink-soft">(optional)</span>
      )
    }
  </label>

  {hint && <p id={`${id}-hint`} class="mb-1.5 text-xs leading-relaxed text-ink-soft">{hint}</p>}

  {
    type === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        aria-describedby={describedBy}
        class={`${controlClass} resize-y`}
      />
    ) : type === 'select' ? (
      <select
        id={id}
        name={name}
        required={required}
        aria-describedby={describedBy}
        class={`${controlClass} appearance-none bg-[length:1.1rem] bg-[right_0.85rem_center] bg-no-repeat pr-10`}
        style="background-image:url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234a5567' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m6 9 6 6 6-6'/%3E%3C/svg%3E&quot;)"
      >
        <option value="">Please choose…</option>
        {options.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        inputmode={inputmode}
        data-digits={digits}
        maxlength={digits ? digits + 4 : undefined}
        aria-describedby={describedBy}
        class={controlClass}
      />
    )
  }

  <p id={`${id}-error`} data-field-error hidden class="mt-1.5 text-xs font-medium text-rose-600"></p>
</div>
