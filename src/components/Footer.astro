---
import { withBase } from '../lib/links';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, schedule, site } from '../data/site';
import { courses } from '../data/courses';

const year = new Date().getFullYear();
const footerCourses = courses.slice(0, 6);
---

<footer class="relative mt-24 overflow-hidden bg-navy-700 text-navy-100">
  <!-- A kolam-inspired motif, the threshold pattern drawn outside Tamil homes. -->
  <svg
    class="pointer-events-none absolute -left-10 -top-10 h-56 w-56 text-navy-500 opacity-40"
    viewBox="0 0 100 100"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="0.8"
  >
    <circle cx="50" cy="50" r="46"></circle>
    <circle cx="50" cy="50" r="34"></circle>
    <circle cx="50" cy="50" r="22"></circle>
    {
      Array.from({ length: 12 }).map((_, i) => (
        <ellipse cx="50" cy="50" rx="46" ry="14" transform={`rotate(${i * 15} 50 50)`} />
      ))
    }
  </svg>
  <svg
    class="pointer-events-none absolute -bottom-16 -right-12 h-64 w-64 text-navy-500 opacity-40"
    viewBox="0 0 100 100"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="0.8"
  >
    {
      Array.from({ length: 10 }).map((_, i) => (
        <ellipse cx="50" cy="50" rx="44" ry="11" transform={`rotate(${i * 18} 50 50)`} />
      ))
    }
    <circle cx="50" cy="50" r="8"></circle>
  </svg>

  <div class="relative">
    <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Identity -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3">
          <Logo class="h-12 w-12" />
          <div>
            <p class="font-display text-2xl font-bold text-white">{site.shortName}</p>
            <p class="text-xs font-medium text-gold-300">{site.location}</p>
          </div>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-200">
          {site.name}. A non-profit initiative serving the rural community — funded by the
          founder's family, never by public donation.
        </p>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-navy-800 px-3 py-1.5 text-xs font-semibold text-gold-200">
          <Icon name="heart" class="h-3.5 w-3.5" />
          Non-profit · No donations solicited
        </p>
      </div>

      <!-- Pages -->
      <nav class="lg:col-span-2" aria-label="Footer">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gold-300">Pages</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a class="text-navy-200 transition-colors hover:text-white" href={withBase(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a class="font-semibold text-white transition-colors hover:text-gold-300" href={withBase('/apply/')}>
              Apply for Admission
            </a>
          </li>
        </ul>
      </nav>

      <!-- Programmes -->
      <nav class="lg:col-span-3" aria-label="Programmes">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gold-300">Programmes</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            footerCourses.map((course) => (
              <li>
                <a
                  class="text-navy-200 transition-colors hover:text-white"
                  href={withBase(`/courses/#${course.id}`)}
                >
                  {course.name}
                </a>
              </li>
            ))
          }
          <li>
            <a class="font-medium text-gold-200 transition-colors hover:text-white" href={withBase('/courses/')}>
              All {courses.length} programmes →
            </a>
          </li>
        </ul>
      </nav>

      <!-- Reach us -->
      <div class="lg:col-span-3">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gold-300">Reach the Academy</h2>
        <ul class="mt-4 space-y-3.5 text-sm">
          <li class="flex gap-3">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-gold-300" />
            <span class="text-navy-200">
              {site.address.line2}<br />{site.address.line3}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-gold-300" />
            <a class="text-navy-200 transition-colors hover:text-white" href={site.phoneHref}>
              {site.phone}
            </a>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-gold-300" />
            <a class="break-all text-navy-200 transition-colors hover:text-white" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          </li>
          <li class="flex gap-3">
            <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-gold-300" />
            <span class="text-navy-200">
              Library {schedule.library.time}<br />Classes {schedule.classes.time}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-navy-500/50">
      <div
        class="container-page flex flex-col items-center justify-between gap-3 py-5 text-center text-xs text-navy-300 sm:flex-row sm:text-left"
      >
        <p>© {year} {site.name}, {site.location}.</p>
        <p class="tamil text-gold-200" lang="ta">
          கற்க கசடறக் கற்பவை கற்றபின் நிற்க அதற்குத் தக
          <span class="font-sans text-navy-300">(குறள் 391)</span>
        </p>
      </div>
    </div>
  </div>
</footer>
