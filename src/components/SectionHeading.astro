---
/** A centred heading between two gold rules — the Academy's print-poster look. */
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h2' | 'h3';
  class?: string;
}

const { title, subtitle, as: Tag = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['text-center', className]}>
  <div class="flex items-center justify-center gap-4 sm:gap-6">
    <span class="rule-gold hidden h-px flex-1 sm:block" aria-hidden="true"></span>
    <Tag class="text-2xl font-bold sm:text-[1.75rem] md:text-[2rem]">{title}</Tag>
    <span class="rule-gold hidden h-px flex-1 sm:block" aria-hidden="true"></span>
  </div>
  {
    subtitle && (
      <p class="mx-auto mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft">{subtitle}</p>
    )
  }
</div>
