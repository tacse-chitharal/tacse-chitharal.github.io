---
import { withBase } from '../lib/links';
import Icon from './Icon.astro';
import type { Course } from '../data/courses';

interface Props {
  course: Course;
  /** `compact` is the home-page card; `full` adds the summary line. */
  variant?: 'compact' | 'full';
}

const { course, variant = 'compact' } = Astro.props;

const accents: Record<Course['accent'], string> = {
  navy: 'bg-navy-100 text-navy-600',
  green: 'bg-emerald-100 text-emerald-700',
  violet: 'bg-violet-100 text-violet-700',
  gold: 'bg-gold-100 text-gold-600',
  teal: 'bg-teal-100 text-teal-700',
  rose: 'bg-rose-100 text-rose-700',
};
---

<article
  class="card group flex flex-col p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-navy-200 hover:shadow-[var(--shadow-lift)]"
>
  <div class="flex items-start gap-4">
    <span
      class:list={[
        'flex h-12 w-12 shrink-0 items-center justify-center rounded-full',
        accents[course.accent],
      ]}
    >
      <Icon name={course.icon} class="h-6 w-6" />
    </span>
    <h3 class="pt-0.5 text-[1.3rem] font-bold leading-tight">
      {course.name}
    </h3>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-ink-soft">{course.target}</p>

  {
    variant === 'full' && (
      <p class="mt-3 border-t border-cream-200 pt-3 text-sm leading-relaxed text-ink-soft">
        {course.summary}
      </p>
    )
  }

  <p class="mt-4 flex items-center gap-2 text-sm font-medium text-gold-600">
    <Icon name="clock" class="h-[18px] w-[18px]" />
    {course.duration}
  </p>

  <a
    href={withBase(`/courses/${course.id}/`)}
    class="mt-5 inline-flex items-center gap-2 border-t border-cream-200 pt-4 text-sm font-semibold text-navy-700 transition-colors hover:text-navy-500"
  >
    View course
    <Icon
      name="arrow-right"
      class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
    />
    <span class="sr-only">— {course.name}</span>
  </a>
</article>
