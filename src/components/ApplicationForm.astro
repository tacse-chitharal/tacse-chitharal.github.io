---
import { withBase } from '../lib/links';
import Icon from './Icon.astro';
import FormField from './FormField.astro';
import { courses } from '../data/courses';
import { site } from '../data/site';
import {
  admissionForm,
  financialAidOptions,
  formActionUrl,
  formViewUrl,
  isConfigured,
  qualificationOptions,
} from '../config/google-forms';

const connected = isConfigured(admissionForm);
const entries = admissionForm.entries;
const endpoint = connected ? formActionUrl(admissionForm) : '';
const directLink = connected ? formViewUrl(admissionForm) : '';
---

<div data-google-form-root data-status="idle" class="scroll-mt-28" id="application-form">
  {
    /* Shown only while the Google Form has not been connected. The Academy sees
       this during setup; students never see a half-working form pretending to
       work. */
    !connected && (
      <div class="mb-6 flex gap-3 rounded-xl border border-gold-300 bg-gold-50 p-4">
        <Icon name="alert" class="mt-0.5 h-5 w-5 shrink-0 text-gold-600" />
        <div class="text-sm leading-relaxed text-gold-700">
          <p class="font-semibold">Setup step remaining: connect the Google Form.</p>
          <p class="mt-1">
            Add the form id and <code class="rounded bg-gold-100 px-1 py-0.5 text-[0.8em]">entry.…</code>
            numbers in <code class="rounded bg-gold-100 px-1 py-0.5 text-[0.8em]">src/config/google-forms.ts</code>.
            Step-by-step instructions are in <code class="rounded bg-gold-100 px-1 py-0.5 text-[0.8em]">docs/GOOGLE-FORMS-SETUP.md</code>.
            Until then this form will not accept submissions.
          </p>
        </div>
      </div>
    )
  }

  <!-- Confirmation -->
  <div data-panel="success" hidden class="card border-emerald-200 bg-emerald-50 p-7 text-center sm:p-10">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-600 text-white">
      <Icon name="check" class="h-8 w-8" />
    </span>
    <h3 tabindex="-1" class="mt-5 text-2xl font-bold text-emerald-900 focus:outline-none">
      Your application has reached us
    </h3>
    <p class="mx-auto mt-3 max-w-md leading-relaxed text-emerald-800">
      Thank you. Your details are now with the Academy. A coordinator will telephone you on the
      number you gave, usually within three working days, to confirm your seat and the date your
      batch begins.
    </p>
    <div class="mx-auto mt-6 max-w-md rounded-xl bg-white/70 p-4 text-sm leading-relaxed text-emerald-900">
      <p class="font-semibold">If you do not hear from us</p>
      <p class="mt-1">
        Telephone the Academy on
        <a class="font-semibold underline underline-offset-2" href={site.phoneHref}>{site.phone}</a>
        between 10 AM and 5 PM, or write to
        <a class="font-semibold underline underline-offset-2" href={`mailto:${site.email}`}>
          {site.email}
        </a>.
      </p>
    </div>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href={withBase('/')} class="btn btn-primary">Back to home</a>
      <a href={withBase('/timetable/')} class="btn btn-outline">See the daily timetable</a>
    </div>
  </div>

  <!-- Something went wrong -->
  <div data-panel="error" hidden class="mb-6 rounded-xl border border-rose-300 bg-rose-50 p-5">
    <div class="flex gap-3">
      <Icon name="alert" class="mt-0.5 h-5 w-5 shrink-0 text-rose-600" />
      <div class="text-sm leading-relaxed text-rose-800">
        <p tabindex="-1" class="font-semibold focus:outline-none">We could not send your application</p>
        <p data-message class="mt-1"></p>
        <p class="mt-2">
          You can also telephone the Academy on
          <a class="font-semibold underline underline-offset-2" href={site.phoneHref}>{site.phone}</a>
          {
            directLink && (
              <>
                {' '}or
                <a
                  class="font-semibold underline underline-offset-2"
                  href={directLink}
                  target="_blank"
                  rel="noopener"
                >
                  fill the form directly on Google
                </a>
              </>
            )
          }.
        </p>
      </div>
    </div>
  </div>

  <form
    data-google-form
    data-endpoint={endpoint}
    data-configured={String(connected)}
    novalidate
    class="card p-5 sm:p-7 lg:p-8"
  >
    <!-- Candidate -->
    <fieldset>
      <legend class="flex w-full items-center gap-3 pb-5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">
          1
        </span>
        <span class="font-display text-lg font-bold text-navy-700">Candidate details</span>
        <span class="rule-gold h-px flex-1" aria-hidden="true"></span>
      </legend>

      <div class="grid gap-5 sm:grid-cols-2">
        <FormField
          fieldKey="fullName"
          entry={entries.fullName}
          label="Full name of the candidate"
          required
          autocomplete="name"
          placeholder="As written on your certificates"
          class="sm:col-span-2"
        />

        <FormField
          fieldKey="address"
          entry={entries.address}
          label="Address for communication"
          type="textarea"
          required
          rows={3}
          autocomplete="street-address"
          placeholder="Door number, street, village or town, pin code"
          class="sm:col-span-2"
        />

        <FormField
          fieldKey="mobile"
          entry={entries.mobile}
          label="Mobile number"
          type="tel"
          required
          digits={10}
          inputmode="numeric"
          autocomplete="tel"
          placeholder="10-digit number"
          hint="We will call this number about your admission."
        />

        <FormField
          fieldKey="aadhaar"
          entry={entries.aadhaar}
          label="Aadhaar number"
          required
          digits={12}
          inputmode="numeric"
          placeholder="12-digit number"
          hint="Used only to verify your identity at admission."
        />

        <FormField
          fieldKey="qualification"
          entry={entries.qualification}
          label="Educational qualification"
          type="select"
          required
          options={qualificationOptions}
          class="sm:col-span-2"
        />
      </div>
    </fieldset>

    <!-- Parent or guardian -->
    <fieldset class="mt-9">
      <legend class="flex w-full items-center gap-3 pb-5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">
          2
        </span>
        <span class="font-display text-lg font-bold text-navy-700">Parent or guardian</span>
        <span class="rule-gold h-px flex-1" aria-hidden="true"></span>
      </legend>

      <div class="grid gap-5 sm:grid-cols-2">
        <FormField
          fieldKey="guardianName"
          entry={entries.guardianName}
          label="Father / Mother / Guardian name"
          required
          placeholder="Full name"
        />

        <FormField
          fieldKey="guardianMobile"
          entry={entries.guardianMobile}
          label="Their mobile number"
          type="tel"
          digits={10}
          inputmode="numeric"
          placeholder="10-digit number"
        />

        <FormField
          fieldKey="guardianEmployment"
          entry={entries.guardianEmployment}
          label="Their employment status"
          required
          placeholder="For example: agricultural labour, fisherman, teacher, retired, not employed"
          hint="This helps us assess requests for a fee concession fairly."
          class="sm:col-span-2"
        />
      </div>
    </fieldset>

    <!-- Programmes -->
    <fieldset class="mt-9">
      <legend class="flex w-full items-center gap-3 pb-5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">
          3
        </span>
        <span class="font-display text-lg font-bold text-navy-700">Coaching required for</span>
        <span class="rule-gold h-px flex-1" aria-hidden="true"></span>
      </legend>

      <div data-field>
        <div
          data-required-group
          role="group"
          aria-label="Coaching required for"
          class="grid gap-2.5 sm:grid-cols-2"
        >
          {
            courses.map((course) => (
              <label
                class="flex cursor-pointer items-start gap-3 rounded-lg border border-navy-200 bg-white p-3 transition-colors hover:border-navy-400 hover:bg-navy-50 has-[:checked]:border-navy-500 has-[:checked]:bg-navy-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-navy-500/30"
              >
                <input
                  type="checkbox"
                  name={entries.coachingFor.trim() || undefined}
                  value={course.formValue}
                  data-course-id={course.id}
                  class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-navy-700"
                />
                <span class="text-sm leading-snug">
                  <span class="block font-semibold text-navy-700">{course.name}</span>
                  <span class="mt-0.5 block text-ink-soft">{course.duration}</span>
                </span>
              </label>
            ))
          }
        </div>
        <p data-field-error hidden class="mt-2 text-xs font-medium text-rose-600"></p>
        <p class="mt-2.5 text-xs text-ink-soft">
          You may choose more than one. If you are unsure, pick the closest and we will advise you
          during counselling.
        </p>
      </div>
    </fieldset>

    <!-- Fee concession -->
    <fieldset class="mt-9">
      <legend class="flex w-full items-center gap-3 pb-5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">
          4
        </span>
        <span class="font-display text-lg font-bold text-navy-700">Fee concession</span>
        <span class="rule-gold h-px flex-1" aria-hidden="true"></span>
      </legend>

      <p class="mb-4 text-sm leading-relaxed text-ink-soft">
        The fee is ₹1500 a month. Full or partial waivers are arranged for economically
        disadvantaged rural students, orphans, and single-parent households. Asking will never
        affect your admission.
      </p>

      <div data-field>
        <div data-required-group role="radiogroup" aria-label="Fee concession requested" class="flex flex-wrap gap-2.5">
          {
            financialAidOptions.map((option, index) => (
              <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-navy-200 bg-white px-4 py-2.5 transition-colors hover:border-navy-400 has-[:checked]:border-navy-500 has-[:checked]:bg-navy-50">
                <input
                  type="radio"
                  name={entries.financialAid.trim() || undefined}
                  value={option}
                  checked={index === 0}
                  class="h-[18px] w-[18px] accent-navy-700"
                />
                <span class="text-sm font-semibold text-navy-700">
                  {option === 'Yes' ? 'Yes, I would like to request a concession' : 'No, I will pay the full fee'}
                </span>
              </label>
            ))
          }
        </div>
        <p data-field-error hidden class="mt-2 text-xs font-medium text-rose-600"></p>
      </div>

      <FormField
        fieldKey="financialAidReason"
        entry={entries.financialAidReason}
        label="If you are requesting a concession, please tell us why"
        type="textarea"
        rows={3}
        placeholder="A few lines about your family's circumstances"
        class="mt-5"
      />
    </fieldset>

    <!-- Bots fill this in; people never see it. -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="mt-9 flex flex-col gap-4 border-t border-cream-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md text-xs leading-relaxed text-ink-soft">
        Your details go only to the Academy's own records. We do not share them with anybody else.
        Fields marked <span class="font-semibold text-rose-500">*</span> are required.
      </p>
      <button type="submit" data-submit class="btn btn-primary shrink-0 !px-8 !py-3 disabled:opacity-60">
        <span data-submit-label>Submit application</span>
        <Icon name="arrow-right" class="h-[18px] w-[18px]" />
      </button>
    </div>
  </form>
</div>

<script>
  import { initGoogleForms } from '../scripts/google-form';

  initGoogleForms();

  // Arriving from a course page via "Apply for this course" pre-ticks that
  // programme, so the student does not have to find it in a list of ten.
  const requested = new URLSearchParams(window.location.search).get('course');
  if (requested) {
    const box = document.querySelector<HTMLInputElement>(
      `input[data-course-id="${CSS.escape(requested)}"]`,
    );
    if (box) {
      box.checked = true;
      box.closest('label')?.scrollIntoView({ block: 'center' });
    }
  }
</script>
