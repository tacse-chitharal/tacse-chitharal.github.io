---
import { withBase } from '../lib/links';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site';
---

<BaseLayout title="Page not found" description="The page you were looking for is not here.">
  <section class="container-page flex min-h-[55vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-display text-6xl font-bold text-cream-300">404</p>
    <h1 class="mt-3 text-2xl font-bold sm:text-3xl">This page is not here</h1>
    <p class="mt-3 max-w-md leading-relaxed text-ink-soft">
      The address may have changed, or there may be a small mistake in the link. Everything on the
      site is reachable from the pages below.
    </p>

    <nav class="mt-8 flex flex-wrap justify-center gap-2.5" aria-label="Site pages">
      {
        nav.map((item) => (
          <a href={withBase(item.href)} class="btn btn-outline !px-4 !py-2 !text-sm">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href={withBase('/apply/')} class="btn btn-primary mt-6">
      Apply for Admission
      <Icon name="arrow-right" class="h-[18px] w-[18px]" />
    </a>
  </section>
</BaseLayout>
